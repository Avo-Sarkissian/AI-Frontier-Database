# Python cache
__pycache__/
*.pyc

# macOS/Finder/iCloud duplicate artifacts ("pybundle 2.zip", "app 3.js"),
# created when the build overwrites a file in docs/. Untracked junk that must
# never be published next to the real files. Any name with " <digits>" before
# the extension, anywhere under docs/; the built files never contain a space.
docs/**/* [0-9].*
docs/**/* [0-9][0-9].*
docs/pybundle*.zip
*.zip.tmp

# Class deliverables. Only the final report PDF and the slide deck are public;
# the sources, drafts and build scripts stay local.
class-project/*
!class-project/FinalReport_Sarkissian.pdf
!class-project/AI_Frontier_Presentation.pptx
data/derived/
